<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only: allow plain HTTP to a local test server (e.g. http://192.168.1.10:3001).
     Release builds use the platform default (HTTPS only). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
